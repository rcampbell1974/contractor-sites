---
import Base from '../layouts/Base.astro';
import { P } from '../lib.js';
---
<Base title="Privacy | Atlantic Coast Transportation Partners" description="This partner information site collects no personal data. Applications are handled in the RideBroker partner portal.">
<section class="sec"><div class="wrap prose"><h1 style="font-size:clamp(2rem,4vw,3rem)">Privacy</h1><hr class="rule" />
<p>This site does not collect personal information. It has no forms.</p>
<p>When you choose Apply, you move to our RideBroker partner portal, where you create an account and submit company, license and insurance details. That information is used to review your application.</p>
<p>Questions or deletion requests: <a href={`mailto:${P.email}`}>{P.email}</a>.</p></div></section>
</Base>
