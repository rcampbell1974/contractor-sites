---
import '../styles.css';
import { P, M } from '../lib.js';
import Schema from '../components/Schema.astro';
const { title, description, faqs } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const sites = Object.entries(P.markets);
---
<html lang="en"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title><meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={url} /><meta property="og:image" content={new URL('/img/hero.webp', Astro.site)} />
<meta name="theme-color" content="#0e0c09" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<Schema faqs={faqs} />
</head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="site"><div class="wrap bar">
  <a href="/" class="brand"><span class="brand-main">Atlantic Coast</span><span class="brand-sub">Partner network</span></a>
  <nav class="nav" aria-label="Main"><a href="/#how">How it works</a><a href="/requirements/">Requirements</a><a href="/#faq">FAQ</a><a class="btn btn-sm" href={P.applyUrl} rel="noopener">Apply now</a></nav>
</div></header>
<main id="main"><slot /></main>
<footer class="foot"><div class="wrap">
  <div class="cols">
    <div><div class="brand-main" style="font:500 1.3rem var(--serif);color:#f6f2ea">{P.brand}</div><p>Partner network for licensed and insured limousine, black-car, party bus and coach companies.</p></div>
    <div><h4>Markets</h4>{sites.map(([k,m])=><a href={`https://${m.host}/`}>{k==='hub'?'All markets':m.name}</a>)}</div>
    <div><h4>Company</h4><a href={P.mainSite}>Book a ride</a><a href="/requirements/">Requirements</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href={`mailto:${P.email}`}>{P.email}</a></div>
  </div>
  <div class="legal">© {new Date().getFullYear()} {P.brand}.</div>
</div></footer>
<a class="sticky-cta" href={P.applyUrl} rel="noopener">Apply now</a>
</body></html>
